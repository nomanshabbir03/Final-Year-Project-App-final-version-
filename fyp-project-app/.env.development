# Development environment variables (shared by the whole team - no personal values here)
#
# The backend URL is detected automatically: the app talks to port 8080 on the same
# computer that runs `npm start`. Only set EXPO_PUBLIC_BACKEND_URL to override it,
# e.g. in a git-ignored .env.local file:
#   EXPO_PUBLIC_BACKEND_URL=http://192.168.1.20:8080

# App uses React Navigation (App.tsx), not expo-router; skip the SDK 56+ conflict check
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
