# Copy to .env.local (git-ignored) and set your own values. Do not commit personal IPs.

# Backend base URL = http://<PC-LAN-IP>:8000  (find the IP with `ipconfig`, Wi-Fi IPv4).
# No /api suffix: the app's calls already include their paths (/auth/..., /api/fitness/...).
# Optional on the same Wi-Fi in LAN mode (auto-derived from the Expo dev host); required for
# tunnel mode, release builds, and physical devices when auto-detection is wrong.
EXPO_PUBLIC_BACKEND_URL=http://<PC-LAN-IP>:8000

# Optional: User ID for development/testing
# EXPO_PUBLIC_USER_ID=your-user-id

# Supabase Auth (Dashboard > Project Settings > API). The anon key is public by design.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
