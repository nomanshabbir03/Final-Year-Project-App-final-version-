# Copy this file to .env (setup scripts do it for you) and fill in real values.
# Defaults below are for LOCAL DEVELOPMENT only.
SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3

# Optional - weather module needs a key from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional - leave empty to print emails to the console
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Supabase Auth (Project Settings > API). The app signs users in with Supabase and the
# backend verifies the access token it receives.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only if the project still uses the legacy HS256 JWT secret:
SUPABASE_JWT_SECRET=

# AI assistant (chatbot) - get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Extra keys are used automatically when the one above hits its limit (any name that starts
# with GEMINI_API_KEY_, or several keys separated by commas):
# GEMINI_API_KEY_2=
# Optional: comma-separated models tried in order when one is out of quota
# (default gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview)
GEMINI_MODEL=
# Optional: voice replies model (default gemini-3.8-flash-tts)
GEMINI_TTS_MODEL=

# Fallback when Gemini is down or out of quota - key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_API_KEY_2=
# Optional: comma-separated chat models (default openai/gpt-oss-120b,openai/gpt-oss-20b)
GROQ_MODEL=
