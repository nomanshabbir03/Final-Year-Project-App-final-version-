# Copy this file to .env (setup scripts do it for you) and fill in real values.
# Defaults below are for LOCAL DEVELOPMENT only.
SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3

# Optional - weather module needs a key from https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional - leave empty to print emails to the console
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Supabase Auth (Project Settings > API). The app signs users in with Supabase and the
# backend verifies the access token it receives.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only if the project still uses the legacy HS256 JWT secret:
SUPABASE_JWT_SECRET=
